# 必須
DISCORD_TOKEN=
DEEPSEEK_API_KEY=

# 反応するサーバーID（カンマ区切り）。空なら招待されたすべてのサーバーで反応する
ALLOWED_GUILD_IDS=

# DMで話せる人のユーザーID（カンマ区切り）。DMではメンションなしで毎回返事する。空ならDMには反応しない
DM_USER_IDS=

# モデル（deepseek-flash = DeepSeek-V4.1-Flash、deepseek-v4-pro = 上位モデル）
DEEPSEEK_MODEL=deepseek-flash
TEMPERATURE=1.1
MAX_OUTPUT_TOKENS=600
# 思考モード（1で有効）。自然さが上がる代わりに遅く高くなる。有効時は TEMPERATURE は無視され、THINKING_MAX_TOKENS が推論込みの上限になる
THINKING=0
# 思考モードの上限（思考＋返事のトークン数）。使い切って返事が空なら、思考なしで答え直す
THINKING_MAX_TOKENS=2000
THINKING_MAX_TOKENS=3000

# 文脈として読むチャンネルの直近メッセージ数と、何時間前まで読むか
HISTORY_LIMIT=20
HISTORY_MAX_AGE_HOURS=12

# 同じ人が連投したとき、この秒数以内は無視する（API代の節約）
USER_COOLDOWN_SEC=3

# 調べものツール（Web検索・URL読み取り・気象庁の天気。1で有効）
ENABLE_WEB_SEARCH=1
# 検索は SearXNG → Serper → DuckDuckGo の順に、設定があるものを使う。何もなければ DuckDuckGo
# Serper の API キー（任意。https://serper.dev で無料・カード不要で取得、最初に2500回分。Google の検索結果）
SERPER_API_KEY=
# VPS 内で動かしている SearXNG（deploy/searxng/install.sh で導入。Google・Bing・DuckDuckGo をまとめて検索、無料・回数無制限）
SEARXNG_URL=

# 利用額の上限（USD、日本時間で日・月が切り替わる）。超えたら返事せず 💤 リアクションだけ付ける。0で無制限
DAILY_BUDGET_USD=0.1
MONTHLY_BUDGET_USD=2

# 料金（USD / 100万トークン）。安全側にピーク時の単価で見積もる
PRICE_INPUT_MISS=0.3
PRICE_INPUT_HIT=0.006
PRICE_OUTPUT=1.2

# 何回会話したらその人のプロファイルを更新するか（初回の会話のあとはすぐ作る）
PROFILE_UPDATE_EVERY=3

# 話しかけてきた人との過去のやりとりを何件まで読むか（チャンネルをまたいで覚えている）
SPEAKER_PAST_LIMIT=3
